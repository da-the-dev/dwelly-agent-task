DWELLY_BASE_URL=https://167.172.96.156.sslip.io
# Handed out at the start of the live session. Left empty, main.ts reports it as missing.
DWELLY_TOKEN=
# OpenRouter key for the LLM calls (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Optional. Default: deepseek/deepseek-v4.1-flash-1017 (see DECISIONS.md).
LLM_MODEL=
# Optional. OpenRouter provider endpoints, comma-separated, no fallback. Default: deepinfra/fp8.
# "any" lets OpenRouter pick (runs are then not comparable: providers quantize differently).
LLM_PROVIDERS=
# Optional. Open a Dwelly case for out-of-scope reports too (it tells the landlord). Default: true.
OPEN_CASE_OUT_OF_SCOPE=
# Optional. The number the safety line gives in an emergency message (rung 5). Default: 999 (UK).
EMERGENCY_NUMBER=
# Optional. Langfuse: trace viewer and prompt editor (https://cloud.langfuse.com, project keys).
# Without the keys nothing is sent. LANGFUSE_TRACES=off keeps the keys for `npm run prompts` only.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACES=
