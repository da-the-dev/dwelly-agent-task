"string","minLength":1,"maxLength":10000}},"required":["body"]}},"parameters":{}},"paths":{"/events":{"get":{"description":"Poll the world event feed of your session. Events are ordered by cursor, strictly ascending. Cursors are monotonically increasing but NOT contiguous — gaps are expected and normal; always pass next_cursor back as ?after= on your next poll.","security":[{"Bearer":[]}],"parameters":[{"schema":{"type":"integer","description":"Return events with cursor strictly greater than this value. Cursors are monotonically increasing but NOT contiguous."},"required":false,"description":"Return events with cursor strictly greater than this value. Cursors are monotonically increasing but NOT contiguous.","name":"after","in":"query"},{"schema":{"type":"integer","minimum":1,"maximum":500,"default":100,"description":"Maximum number of events to return."},"required":false,"description":"Maximum number of events to return.","name":"limit","in":"query"}],"responses":{"200":{"description":"Ordered world events after the cursor. Cursors are monotonically increasing but NOT contiguous — never assume cursor == previous + 1. When there are no new events, `events` is empty and `next_cursor` echoes your input cursor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EventsResponse"}}}},"400":{"description":"Invalid cursor or limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/contractors":{"get":{"description":"The contractor directory available for work orders.","security":[{"Bearer":[]}],"responses":{"200":{"description":"All contractors, in stable order.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContractorsResponse"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/history/cases":{"get":{"description":"The archive of past resolved maintenance cases.","security":[{"Bearer":[]}],"responses":{"200":{"description":"All archived cases.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HistoryCasesResponse"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/cases":{"post":{"description":"Create a maintenance case. Opening one puts the job on the record and the LANDLORD is told about it — expect to hear from them in your events feed. A contractor is NOT: nothing reaches a contractor until you raise a work order for them. So you never have to write to anyone merely to announce a case. Every POST creates a new case: there is no implicit deduplication of identical requests.","security":[{"Bearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CaseCreate"}}}},"responses":{"201":{"description":"The created case.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Case"}}}},"400":{"description":"Invalid body.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Session has ended — mutations are closed (reads still work).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many world-changing requests in one minute (reads are never limited).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/cases/{id}":{"patch":{"description":"Update fields of one of your cases. At least one field is required. The world sees the update in your events feed.","security":[{"Bearer":[]}],"parameters":[{"schema":{"type":"string"},"required":true,"name":"id","in":"path"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CasePatch"}}}},"responses":{"200":{"description":"The updated case.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Case"}}}},"400":{"description":"Invalid or empty body.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Session has ended — mutations are closed (reads still work).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Case not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many world-changing requests in one minute (reads are never limited).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/work-orders":{"post":{"description":"Send a work order to a contractor for one of your cases. Raising the work order IS how you engage that contractor: you do not need to message them to place the job. You choose the contractor BEFORE raising the order — this is an assignment, not a call for competing bids. Their decision comes back asynchronously as a work_order.accepted or work_order.declined event — the 201 body is status \"pending\", not an answer. A refusal is a normal outcome: raise another order for a different contractor. cost_estimate_gbp is optional here because a price usually arrives with the contractor's reply, after they have seen the job; record it with PATCH /work-orders/{id} when you have it.","security":[{"Bearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkOrderCreate"}}}},"responses":{"201":{"description":"The created work order (status pending).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkOrder"}}}},"400":{"description":"Invalid body.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Session has ended — mutations are closed (reads still work).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Unknown contractor or case.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many world-changing requests in one minute (reads are never limited).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/work-orders/{id}":{"patch":{"description":"Record what a work order actually costs, whether the landlord has signed that spend off, and the appointment slot once one is agreed. Contractors quote in their replies, a landlord may cap what can be spent without asking, and a visit time is settled after the order is raised — this endpoint is where all three facts land on the record. At least one field is required. It changes nothing in the world by itself: approving a spend here is your record of an agreement, not a request for one. The slot matters beyond bookkeeping: a contractor confirms a visit from their side only once an appointment is on their accepted order, so write the agreed time here before you expect them to confirm it.","security":[{"Bearer":[]}],"parameters":[{"schema":{"type":"string"},"required":true,"name":"id","in":"path"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkOrderUpdate"}}}},"responses":{"200":{"description":"The updated work order.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkOrder"}}}},"400":{"description":"Invalid or empty body.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Session has ended — mutations are closed (reads still work).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Work order not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many world-changing requests in one minute (reads are never limited).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/actors/{id}/messages":{"post":{"description":"Send a message to any actor — tenants, the landlord, and contractors alike (contractor ids from GET /contractors work here). Actor ids also appear as actor.id on the events you receive. Messaging is the conversation itself: asking questions, giving instructions, keeping people posted — that part is yours to decide on. Every message gets a reply; replies arrive asynchronously in your events feed.","security":[{"Bearer":[]}],"parameters":[{"schema":{"type":"string"},"required":true,"name":"id","in":"path"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ActorMessage"}}}},"responses":{"202":{"description":"Message accepted for delivery.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ActorMessageAccepted"}}}},"400":{"description":"Invalid body.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Session has ended — mutations are closed (reads still work).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Unknown actor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many world-changing requests in one minute (reads are never limited).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}},"webhooks":{}}